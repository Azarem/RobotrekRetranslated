{
    "name": "Robotrek Retranslation Scripts",
    "version": "1.0.0",
    "description": "Extract translation data from Gaia Gensouki Excel spreadsheet",
    "type": "module",
    "main": "index.js",
    "scripts": {
      "build": "tsc",
      "extract": "rm -r -f extracted && node --env-file=.env.local scripts/index.ts extract",
      "rebuild": "node --env-file=.env.local scripts/index.ts rebuild",
      "test": "vitest run"
    },
    "keywords": [
      "translation",
      "excel",
      "json"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
    },
    "devDependencies": {
      "@paralleldrive/cuid2": "^2.2.2",
      "@types/node": "^20.10.0",
      "typescript": "^5.3.0",
      "@gaialabs/robotrek-baserom": "0.1.1",
      "@prisma/adapter-pg": "^7.6.0",
      "dotenv": "^17.4.0",
      "vitest": "^4.1.2"
    }
  }
  
  